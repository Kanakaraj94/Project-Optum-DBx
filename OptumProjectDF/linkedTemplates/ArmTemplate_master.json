{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "OptumProjectDF"
		},
		"Adls2Adf_ls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdataoptum.dfs.core.windows.net"
		},
		"AzureKeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://keyvaultOptum.vault.azure.net/"
		},
		"Blob2Adf_ls_properties_typeProperties_connectionString_secretName": {
			"type": "string",
			"defaultValue": "BlobConnStr"
		},
		"Mongo2Adf_ls_properties_typeProperties_connectionString_secretName": {
			"type": "string",
			"defaultValue": "MongoConnStr"
		},
		"Mongo2Adf_ls_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "optum_db"
		},
		"MySql2Adf_ls_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"MySql2Adf_ls_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "optum_db"
		},
		"MySql2Adf_ls_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "root"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "OptumProjectDF_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureKeyVault_properties_typeProperties_baseUrl": {
						"value": "[parameters('AzureKeyVault_properties_typeProperties_baseUrl')]"
					},
					"Adls2Adf_ls_properties_typeProperties_url": {
						"value": "[parameters('Adls2Adf_ls_properties_typeProperties_url')]"
					},
					"Blob2Adf_ls_properties_typeProperties_connectionString_secretName": {
						"value": "[parameters('Blob2Adf_ls_properties_typeProperties_connectionString_secretName')]"
					},
					"Mongo2Adf_ls_properties_typeProperties_connectionString_secretName": {
						"value": "[parameters('Mongo2Adf_ls_properties_typeProperties_connectionString_secretName')]"
					},
					"Mongo2Adf_ls_properties_typeProperties_database": {
						"value": "[parameters('Mongo2Adf_ls_properties_typeProperties_database')]"
					},
					"MySql2Adf_ls_properties_typeProperties_server": {
						"value": "[parameters('MySql2Adf_ls_properties_typeProperties_server')]"
					},
					"MySql2Adf_ls_properties_typeProperties_database": {
						"value": "[parameters('MySql2Adf_ls_properties_typeProperties_database')]"
					},
					"MySql2Adf_ls_properties_typeProperties_username": {
						"value": "[parameters('MySql2Adf_ls_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}